# Copy to backend/.env and fill in. NEVER commit the real .env.

# ---------------------------------------------------------------------
# Supabase — needed by the run store and by every agent
# ---------------------------------------------------------------------
# Values: Supabase Dashboard -> Project Settings -> API Keys.

# The API endpoint, NOT the dashboard page URL. A dashboard URL
# (https://supabase.com/dashboard/project/...) returns an HTML login
# page; the agents reject it at startup, but the run store surfaces it
# much later as a confusing "TypeError: string indices must be integers".
SUPABASE_URL=https://uivjesdostuaihbjpdjr.supabase.co

# Use the SECRET key (sb_secret_...). The publishable key has no
# privileges on pipeline_runs / pipeline_stage_runs and writes fail
# with "42501 permission denied", which makes app.py fall back to the
# in-memory store and lose every run when the process stops.
SUPABASE_KEY=sb_secret_your_key_here

# Accepted as a fallback for SUPABASE_KEY so the agent .env files that
# predate the shared client keep working. Same limitation as above:
# fine for reading articles, not enough to record pipeline runs.
# SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------------
# Collection agent — news sources
# ---------------------------------------------------------------------
# Optional. A source with no key is skipped with a message; the RSS
# feeds need no key, so collection still works without either of these.
NEWS_API_KEY=your-newsapi-key
GNEWS_API_KEY=your-gnews-key
# The Guardian Open Platform (agents/collection/guardian_fetcher.py).
# Free developer key: https://open-platform.theguardian.com/access/
# Reader comments need no key.
GUARDIAN_API_KEY=your-guardian-key

# ---------------------------------------------------------------------
# LLM (Luna) — collection's relevance check and the LLM classifier
# ---------------------------------------------------------------------
# Needed to collect new articles: collection only keeps an article once
# the LLM confirms it is relevant, so a live collection run without these
# fails before fetching anything. (--backlog runs don't collect.)
#
# For classification they are optional. With both set to real values the
# LLM classifier runs as the primary agent and the keyword scorer becomes
# its fallback. Left as placeholders, the keyword scorer is the primary
# and nothing is lost but accuracy — a "your-..." value counts as unset,
# so a copied example file doesn't make every run fail on a 401 first.
TRUSSED_API_KEY=your-trussed-api-key
TRUSSED_BASE_URL=https://trussed.eng.fau.edu/provider/generic/chat/completions

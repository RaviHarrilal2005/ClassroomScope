# Copy to backend/.env and fill in. NEVER commit the real .env.
# Values: Supabase Dashboard -> Project Settings -> API Keys.

# The API endpoint, NOT the dashboard page URL.
SUPABASE_URL=https://uivjesdostuaihbjpdjr.supabase.co

# Use the SECRET key (sb_secret_...). The publishable key has no
# privileges on pipeline_runs / pipeline_stage_runs and writes fail
# with "42501 permission denied".
SUPABASE_KEY=sb_secret_your_key_here
